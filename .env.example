# === Aplicação do Mercado Livre ===
# Use o MESMO App ID / Secret dos robôs do dashboard-ml-bot.
# O Brasil só permite 1 aplicação por conta, e o refresh_token é de uso único:
# o painel renova o token e grava o par novo na tabela `contas`, junto com os robôs.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Conta usada por padrão (seller_id da tabela `contas`). Dá para trocar na interface.
# 471489691 = PONTO MUSICAL-CABOFRIO | 177795203 = PONTOMUSICAL_CF
# 3244206480 = PONTOMUSICAL_MG | 1104686442 = IRMAOS_BROTHERS | 1814100 = BANANA MUSIC
ML_SELLER_ID_PADRAO=177795203

# === Supabase (projeto dashboard-mercadolivre) ===
SUPABASE_URL=https://szrrrnelgozeizmbtivm.supabase.co
# service_role: só é usada no servidor, NUNCA exponha no browser
SUPABASE_SERVICE_ROLE_KEY=

# === Trava simples do painel ===
PANEL_PASSWORD=

# === Claude (opcional) — analisar e reescrever descrições ===
# Chave em https://console.anthropic.com — o custo é por uso, na sua conta.
# Sem ela o painel funciona normalmente; só os botões de IA ficam desligados.
ANTHROPIC_API_KEY=
# Modelos atuais: https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5
