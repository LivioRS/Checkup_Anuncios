# === Aplicação do Mercado Livre ===
# Use o MESMO App ID / Secret dos robôs do dashboard-ml-bot.
# O Brasil só permite 1 aplicação por conta, e o refresh_token é de uso único:
# o painel renova o token e grava o par novo na tabela `contas`, junto com os robôs.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Conta usada por padrão (seller_id da tabela `contas`). Dá para trocar na interface.
# 471489691 = PONTO MUSICAL-CABOFRIO | 177795203 = PONTOMUSICAL_CF
# 3244206480 = PONTOMUSICAL_MG | 1104686442 = IRMAOS_BROTHERS | 1814100 = BANANA MUSIC
ML_SELLER_ID_PADRAO=177795203

# === Aplicação do Mercado Livre — portal (cliente, plano 022 / card f1c3) ===
# App SEPARADO do de cima: cada app do Mercado Livre só aceita 1 redirect_uri cadastrado, e o
# portal (contas de cliente terceiro, tabela `contas_ml_clientes`) precisa de um redirect_uri
# próprio, diferente do fluxo dos robôs. Registre um app novo no DevCenter do Mercado Livre.
# O redirect_uri cadastrado lá precisa bater EXATAMENTE com ML_REDIRECT_URI_PORTAL abaixo (sem
# parte variável) — divergência dá `redirect_uri_error` no ML.
ML_CLIENT_ID_PORTAL=
ML_CLIENT_SECRET_PORTAL=
ML_REDIRECT_URI_PORTAL=

# === Supabase (projeto Chckup_Anuncios) ===
# Corrigido no plano 023 (card f1c4): o valor antigo aqui (szrrrnelgozeizmbtivm) não batia com o
# projeto real conectado a este repo — confirmado via MCP do Supabase, tabelas idênticas ao
# `supabase/schema.sql` (contas, clientes, contas_ml_clientes etc.) só existem em vcxweutjmmycajnulkak.
SUPABASE_URL=https://vcxweutjmmycajnulkak.supabase.co
# service_role: só é usada no servidor, NUNCA exponha no browser
SUPABASE_SERVICE_ROLE_KEY=

# === Supabase Auth — portal do cliente (plano 023 / card f1c4) ===
# Chave ANÔNIMA — ao contrário da service_role acima, esta é feita pra ir no bundle do browser
# (é assim que o Supabase Auth funciona no client). Mesmo projeto/URL de cima. Precisa do
# prefixo NEXT_PUBLIC_ pro Next.js embutir no bundle do client — sem ele o login do portal
# (`/portal/*`) não funciona.
NEXT_PUBLIC_SUPABASE_URL=https://vcxweutjmmycajnulkak.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZjeHdldXRqbW15Y2FqbnVsa2FrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgxOTQ0OTIsImV4cCI6MjEwMzc3MDQ5Mn0.YzQa4i3OwVrmIUetkjWVFaIULaFfeySBXYBFvwAnxMg

# === Trava simples do painel ===
PANEL_PASSWORD=

# === IA (opcional) — analisar/reescrever descrições, escolher categoria, roteiro de fotos ===
# O painel aceita DOIS provedores e escolhe sozinho: se OPENROUTER_API_KEY estiver setada,
# usa OpenRouter; senão, se ANTHROPIC_API_KEY estiver setada, usa a Anthropic direto; senão,
# os botões de IA ficam desligados e o resto do painel funciona normalmente.

# OpenRouter (gateway OpenAI-compatível — roteia pra Claude e outros).
# Chave em https://openrouter.ai/keys. OPENROUTER_MODEL é OBRIGATÓRIO se usar OpenRouter:
# copie um slug EXATO de https://openrouter.ai/models que a sua conta acessa (filtre por ":free"
# pra custo zero — modelos free têm limite de taxa e mudam com frequência).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Anthropic direto. Chave em https://console.anthropic.com.
# Modelos atuais: https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# === Busca web (opcional) — buscar ficha técnica no site do fabricante (plano 033) ===
# Sem isso, o botão "Buscar ficha no site da marca" fica desligado. Só specs FACTUAIS entram
# na ficha; foto do fabricante NUNCA (regra do ML + direito autoral). Chave em https://tavily.com
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
